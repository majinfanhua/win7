# ---- Node / Electron ----
node_modules/
out/
dist/
release/
*.log
npm-debug.log*
.npm/

# ---- 构建缓存 ----
.vite/
*.tsbuildinfo

# ---- 自检产物（smoke / --self-test 的输出，CI 单独上传，不入库）----
selftest.json
selftest-*.json

# ---- 参考资料（他人项目，仅本地阅读，绝不入库）----
#
# 整目录忽略，而不是只忽略里面的 node_modules：
# 这些是**别人的仓库**，混进本项目的历史里既没用又侵权风险。
# 用 `/` 开头锚定到仓库根 —— 不锚定的话，以后任何子目录里
# 出现同名文件夹都会被一起忽略，那种静默失效很难查。
/参考项目-LiveAgent/
/ref/

# ---- 环境与本地配置 ----
.env
.env.local
.dev-config/

# ---- 编辑器 ----
.idea/
.vscode/*
!.vscode/extensions.json

# ---- 系统 ----
.DS_Store
Thumbs.db

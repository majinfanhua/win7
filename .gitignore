# ---- Node / Electron ----
node_modules/
out/
dist/
release/
*.log
npm-debug.log*
.npm/

# ---- 构建缓存 ----
.vite/
*.tsbuildinfo

# ---- 自检产物（smoke / --self-test 的输出，CI 单独上传，不入库）----
selftest.json
selftest-*.json

# ---- 参考资料（他人的仓库，一律不入库）----
#
# 曾经的 `参考项目-LiveAgent/` 已按要求从工作区删除，这里保留忽略规则
# 作为兜底：以后再拷别人的仓库进来阅读时，不会被 git status 看见，
# 也就不会误提交进历史（那些是**别人的代码**，入库既没用又有侵权风险）。
# 用 `/` 开头锚定到仓库根 —— 不锚定的话，以后任何子目录里出现同名
# 文件夹都会被一起忽略，那种静默失效很难查。
/ref/
/参考*/

# ---- 环境与本地配置 ----
.env
.env.local
.dev-config/

# ---- 编辑器 ----
.idea/
.vscode/*
!.vscode/extensions.json

# ---- 系统 ----
.DS_Store
Thumbs.db
